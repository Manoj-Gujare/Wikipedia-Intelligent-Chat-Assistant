# ---- Required ----
# Used for both chat completions and embeddings.
OPENAI_API_KEY=sk-your-key-here

# ---- Models ----
# Measured 2026-08-16 on the 26-case suite (python -m scripts.evaluate):
#   gpt-4.1-nano  100% accuracy, p50 2.22-2.55s, follow-up p50 2.04-2.67s (default)
#   gpt-4.1-mini   95% accuracy, p50 2.58s, follow-up p50 4.85s — misses the
#                  budget on every follow-up; writes 52-word answers vs nano's 40
#   gpt-4o-mini    80% accuracy — drops facts the excerpts contain; avoid
CHAT_MODEL=gpt-4.1-nano
# The agent's tool-decision call. Sits on the critical path of every
# turn, so it is a small model emitting one tool call — not the model that
# writes the answer. It also writes small-talk replies directly, which is well
# within a nano model's range: one or two sentences with no facts in them.
AGENT_MODEL=gpt-4.1-nano
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Agent budget ----
# A second retrieval hop is allowed only while the turn still has room for it.
# The gate is wall-clock, not a hop count: at 1.2s in, another hop (~0.4s) plus
# generation (~1.5s) still lands near 3.1s; at 1.6s in it cannot. Set to 0 to
# forbid second hops entirely.
AGENT_HOP_DEADLINE_MS=1200
# Hard ceiling regardless of the clock, so a pathological loop terminates.
AGENT_MAX_HOPS=2
# Race a second decision call once the first has taken this long. The 3s budget
# is missed by stalled requests, not slow work: one measured turn spent 10,296ms
# of its 10,320ms inside this call, and the next message took 1.6s. A plain retry
# keeps waiting on the stall; hedging stops waiting. Above the ~1.0s median, so
# it fires on roughly the slowest tenth of calls. Set to 0 to disable.
AGENT_HEDGE_AFTER_MS=1500
# Race a vector search against the decision call. Every turn pays one decision
# call, so every turn can overlap its retrieval with it: a question gets its
# search for free, and a greeting throws one embedding away.
# A referential message is searched stitched to the question before it, which
# carries the subject its pronoun refers to; the agent's resolved query is then
# contained in that, so the parked result is reused. 6/6 benchmark follow-ups
# hit. Disable to trade latency back for the embedding calls it can waste.
AGENT_SPECULATIVE_RETRIEVAL=true
# How much of the agent's query the speculated message must already contain
# before the parked search is reused. Containment, not symmetric overlap — the
# agent's usual edit is to strip filler, and a symmetric measure counts the
# removed words against the match. Rewrites that should reuse scored 0.67-1.00
# and rewrites that must not scored 0.00-0.50, so 0.6 sits in the gap.
AGENT_SPECULATION_REUSE_THRESHOLD=0.6
# Articles whose lead sections ground a live-Wikipedia answer.
AGENT_LIVE_ARTICLES=2

# ---- Vector store ----
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=wikipedia

# ---- Retrieval tuning ----
RETRIEVAL_TOP_K=24
RETRIEVAL_FINAL_K=6
MMR_LAMBDA=0.6
MIN_RELEVANCE_SCORE=0.18
# Lead sections hold the canonical facts; boost keeps them in contention.
INTRO_BOOST=0.07
INTRO_POOL_K=6

# ---- Chunking ----
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=60

# ---- Wikipedia / MediaWiki API compliance ----
# Wikimedia's User-Agent policy requires a descriptive UA with contact info.
# https://meta.wikimedia.org/wiki/User-Agent_policy
# Replace the contact details with your own if you fork this.
WIKI_USER_AGENT=WikipediaIntelligentChatAssistant/1.0 (https://github.com/Manoj-Gujare/Wikipedia-Intelligent-Chat-Assistant; manojgujare726@gmail.com)
WIKI_REQUESTS_PER_SECOND=8
WIKI_MAX_CONCURRENCY=4
WIKI_MAXLAG=5

# ---- Auth ----
# Signing key for session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset locally and one is generated per process (a restart forces
# re-login). MUST be set for multi-worker or production deployments, or tokens
# issued by one worker will not verify on another.
JWT_SECRET=
JWT_TTL_SECONDS=43200

# ---- App ----
CORS_ORIGINS=http://localhost:3000
# SQLite file holding conversation history (survives restarts; gitignored).
CONVERSATIONS_DB=./data/conversations.db
CONVERSATION_TTL_SECONDS=3600
CONVERSATION_MAX_TURNS=12
CACHE_TTL_SECONDS=900
LOG_LEVEL=INFO
